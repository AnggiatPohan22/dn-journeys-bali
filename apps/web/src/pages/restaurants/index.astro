---
import PageLayout from '@layouts/PageLayout.astro'
import RestaurantCard from '@components/cards/RestaurantCard.astro'
import ListingHeader from '@components/common/ListingHeader.astro'
import { getRestaurants } from '@lib/payload'
import { isModuleEnabled } from '@lib/features'
import { resolveListingHeader } from '@lib/listingHeader'
import type { Restaurant } from '@shared/types/payload-types'

if (!(await isModuleEnabled('restaurants'))) return Astro.rewrite('/404')

const header = await resolveListingHeader('restaurants', {
  eyebrow: 'Where to Dine',
  heading: 'Restaurants',
  intro:
    'Hand-picked restaurants across Bali — beachfront seafood, fine dining, hidden warungs, and everything in between. Reserve a table via WhatsApp.',
  metaTitle: 'Restaurants & Reservations',
  metaDescription:
    'Curated restaurants across Bali — from beachfront seafood to fine dining and hidden warungs.',
})

let items: Restaurant[] = []
let totalDocs = 0
let error: string | null = null

try {
  const data = await getRestaurants({ limit: 50, sort: 'sortOrder' })
  items = data.docs
  totalDocs = data.totalDocs
} catch (err) {
  error = err instanceof Error ? err.message : String(err)
}
---

<PageLayout title={header.metaTitle} description={header.metaDescription}>
  <section class="section-padding">
    <div class="container-content">
      <ListingHeader eyebrow={header.eyebrow} heading={header.heading} intro={header.intro} />

      {error && (
        <div class="bg-white border border-coral/40 text-coral-dark rounded-xl p-6 text-sm max-w-2xl mx-auto">
          <p class="font-semibold mb-1">Gagal memuat restaurants</p>
          <pre class="text-xs bg-sand p-3 rounded mt-2 overflow-x-auto">{error}</pre>
        </div>
      )}

      {!error && items.length === 0 && (
        <div class="bg-white border border-sand-dark/10 rounded-xl p-8 text-center max-w-2xl mx-auto">
          <p class="font-display text-xl text-ocean mb-2">Belum ada restoran tersedia</p>
          <p class="text-sm text-stone-light">Silakan cek lagi nanti — kami sedang menyiapkan penawaran terbaru.</p>
        </div>
      )}

      {items.length > 0 && (
        <>
          <p class="text-sm text-stone-light mb-6 text-center">
            {totalDocs} {totalDocs === 1 ? 'restaurant' : 'restaurants'} listed
          </p>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" data-animate="stagger">
            {items.map((restaurant) => <RestaurantCard restaurant={restaurant} />)}
          </div>
        </>
      )}
    </div>
  </section>
</PageLayout>
