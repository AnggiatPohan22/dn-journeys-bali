---
import PageLayout from '@layouts/PageLayout.astro'
import TourCard from '@components/cards/TourCard.astro'
import ListingHeader from '@components/common/ListingHeader.astro'
import { getTours } from '@lib/payload'
import { isModuleEnabled } from '@lib/features'
import { resolveListingHeader } from '@lib/listingHeader'
import type { Tour } from '@shared/types/payload-types'

if (!(await isModuleEnabled('tours'))) return Astro.rewrite('/404')

const header = await resolveListingHeader('tours', {
  eyebrow: 'Explore',
  heading: 'Tours & Activities',
  intro:
    "Curated experiences across Bali's islands and mainland — full-day trips, cultural immersions, and hidden-gem adventures with local guides.",
  metaTitle: 'Tours & Activities',
  metaDescription:
    'Discover curated tours across Bali and its islands — day trips, cultural immersions, and hidden-gem adventures.',
})

let tours: Tour[] = []
let totalDocs = 0
let error: string | null = null

try {
  const data = await getTours({ limit: 50, sort: 'sortOrder' })
  tours = data.docs
  totalDocs = data.totalDocs
} catch (err) {
  error = err instanceof Error ? err.message : String(err)
}
---

<PageLayout title={header.metaTitle} description={header.metaDescription}>
  <section class="section-padding">
    <div class="container-content">
      <ListingHeader eyebrow={header.eyebrow} heading={header.heading} intro={header.intro} />

      {error && (
        <div class="bg-white border border-coral/40 text-coral-dark rounded-xl p-6 text-sm max-w-2xl mx-auto">
          <p class="font-semibold mb-1">Gagal memuat tours</p>
          <pre class="text-xs bg-sand p-3 rounded mt-2 overflow-x-auto">{error}</pre>
        </div>
      )}

      {!error && tours.length === 0 && (
        <div class="bg-white border border-sand-dark/10 rounded-xl p-8 text-center max-w-2xl mx-auto">
          <p class="font-display text-xl text-ocean mb-2">Belum ada tour tersedia</p>
          <p class="text-sm text-stone-light">Silakan cek lagi nanti — kami sedang menyiapkan penawaran terbaru.</p>
        </div>
      )}

      {tours.length > 0 && (
        <>
          <p class="text-sm text-stone-light mb-6 text-center">
            {totalDocs} {totalDocs === 1 ? 'tour' : 'tours'} available
          </p>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" data-animate="stagger">
            {tours.map((tour) => <TourCard tour={tour} />)}
          </div>
        </>
      )}
    </div>
  </section>
</PageLayout>
