---
import PageLayout from '@layouts/PageLayout.astro'
import RentalCard from '@components/cards/RentalCard.astro'
import ListingHeader from '@components/common/ListingHeader.astro'
import { getRentals } from '@lib/payload'
import { isModuleEnabled } from '@lib/features'
import { resolveListingHeader } from '@lib/listingHeader'
import type { Rental } from '@shared/types/payload-types'

if (!(await isModuleEnabled('rentals'))) return Astro.rewrite('/404')

const header = await resolveListingHeader('rentals', {
  eyebrow: 'Get Around Bali',
  heading: 'Rental Service',
  intro:
    'Scooters, cars, bicycles, boats, and gear — reliable rentals with hotel delivery across Bali and the Nusa islands.',
  metaTitle: 'Rental Service',
  metaDescription:
    'Rent scooters, cars, bicycles, boats, and gear across Bali and Nusa Islands.',
})

let items: Rental[] = []
let totalDocs = 0
let error: string | null = null

try {
  const data = await getRentals({ limit: 50, sort: 'sortOrder' })
  items = data.docs
  totalDocs = data.totalDocs
} catch (err) {
  error = err instanceof Error ? err.message : String(err)
}
---

<PageLayout title={header.metaTitle} description={header.metaDescription}>
  <section class="section-padding">
    <div class="container-content">
      <ListingHeader eyebrow={header.eyebrow} heading={header.heading} intro={header.intro} />

      {error && (
        <div class="bg-white border border-coral/40 text-coral-dark rounded-xl p-6 text-sm max-w-2xl mx-auto">
          <p class="font-semibold mb-1">Gagal memuat rentals</p>
          <pre class="text-xs bg-sand p-3 rounded mt-2 overflow-x-auto">{error}</pre>
        </div>
      )}

      {!error && items.length === 0 && (
        <div class="bg-white border border-sand-dark/10 rounded-xl p-8 text-center max-w-2xl mx-auto">
          <p class="font-display text-xl text-ocean mb-2">Belum ada rental tersedia</p>
          <p class="text-sm text-stone-light">Silakan cek lagi nanti — kami sedang menyiapkan penawaran terbaru.</p>
        </div>
      )}

      {items.length > 0 && (
        <>
          <p class="text-sm text-stone-light mb-6 text-center">
            {totalDocs} {totalDocs === 1 ? 'rental' : 'rentals'} available
          </p>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" data-animate="stagger">
            {items.map((rental) => <RentalCard rental={rental} />)}
          </div>
        </>
      )}
    </div>
  </section>
</PageLayout>
