---
import PageLayout from '@layouts/PageLayout.astro'
import AccommodationCard from '@components/cards/AccommodationCard.astro'
import ListingHeader from '@components/common/ListingHeader.astro'
import { getAccommodations } from '@lib/payload'
import { isModuleEnabled } from '@lib/features'
import { resolveListingHeader } from '@lib/listingHeader'
import type { Accommodation } from '@shared/types/payload-types'

if (!(await isModuleEnabled('accommodations'))) return Astro.rewrite('/404')

const header = await resolveListingHeader('accommodations', {
  eyebrow: 'Where to Stay',
  heading: 'Villas & Hotels',
  intro:
    'Private villas, boutique hotels, and resorts across Bali and its islands — each hand-picked for character, comfort, and location.',
  metaTitle: 'Villas & Hotels',
  metaDescription:
    'Villas, hotels, resorts, and guesthouses across Bali — hand-picked stays with local character.',
})

let items: Accommodation[] = []
let totalDocs = 0
let error: string | null = null

try {
  const data = await getAccommodations({ limit: 50, sort: 'sortOrder' })
  items = data.docs
  totalDocs = data.totalDocs
} catch (err) {
  error = err instanceof Error ? err.message : String(err)
}
---

<PageLayout title={header.metaTitle} description={header.metaDescription}>
  <section class="section-padding">
    <div class="container-content">
      <ListingHeader eyebrow={header.eyebrow} heading={header.heading} intro={header.intro} />

      {error && (
        <div class="bg-white border border-coral/40 text-coral-dark rounded-xl p-6 text-sm max-w-2xl mx-auto">
          <p class="font-semibold mb-1">Gagal memuat accommodations</p>
          <pre class="text-xs bg-sand p-3 rounded mt-2 overflow-x-auto">{error}</pre>
        </div>
      )}

      {!error && items.length === 0 && (
        <div class="bg-white border border-sand-dark/10 rounded-xl p-8 text-center max-w-2xl mx-auto">
          <p class="font-display text-xl text-ocean mb-2">Belum ada akomodasi tersedia</p>
          <p class="text-sm text-stone-light">Silakan cek lagi nanti — kami sedang menyiapkan penawaran terbaru.</p>
        </div>
      )}

      {items.length > 0 && (
        <>
          <p class="text-sm text-stone-light mb-6 text-center">
            {totalDocs} {totalDocs === 1 ? 'stay' : 'stays'} available
          </p>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" data-animate="stagger">
            {items.map((accommodation) => <AccommodationCard accommodation={accommodation} />)}
          </div>
        </>
      )}
    </div>
  </section>
</PageLayout>
