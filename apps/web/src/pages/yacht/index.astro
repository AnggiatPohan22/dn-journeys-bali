---
import PageLayout from '@layouts/PageLayout.astro'
import YachtCard from '@components/cards/YachtCard.astro'
import ListingHeader from '@components/common/ListingHeader.astro'
import { getYachts } from '@lib/payload'
import { isModuleEnabled } from '@lib/features'
import { resolveListingHeader } from '@lib/listingHeader'
import type { Yacht } from '@shared/types/payload-types'

if (!(await isModuleEnabled('yacht'))) return Astro.rewrite('/404')

const header = await resolveListingHeader('yachts', {
  eyebrow: 'Charter in Bali',
  heading: 'Private Yacht Charter',
  intro:
    'Catamarans, speedboats, sailing yachts, and phinisi — private charters across Bali and the Nusa islands, crewed and curated.',
  metaTitle: 'Private Yacht Charter',
  metaDescription:
    'Charter private yachts across Bali — catamarans, speedboats, sailing yachts, and phinisi with full crew.',
})

let items: Yacht[] = []
let totalDocs = 0
let error: string | null = null

try {
  const data = await getYachts({ limit: 50, sort: 'sortOrder' })
  items = data.docs
  totalDocs = data.totalDocs
} catch (err) {
  error = err instanceof Error ? err.message : String(err)
}
---

<PageLayout title={header.metaTitle} description={header.metaDescription}>
  <section class="section-padding">
    <div class="container-content">
      <ListingHeader eyebrow={header.eyebrow} heading={header.heading} intro={header.intro} />

      {error && (
        <div class="bg-white border border-coral/40 text-coral-dark rounded-xl p-6 text-sm max-w-2xl mx-auto">
          <p class="font-semibold mb-1">Gagal memuat yachts</p>
          <pre class="text-xs bg-sand p-3 rounded mt-2 overflow-x-auto">{error}</pre>
        </div>
      )}

      {!error && items.length === 0 && (
        <div class="bg-white border border-sand-dark/10 rounded-xl p-8 text-center max-w-2xl mx-auto">
          <p class="font-display text-xl text-ocean mb-2">Belum ada yacht tersedia</p>
          <p class="text-sm text-stone-light">Silakan cek lagi nanti — kami sedang menyiapkan penawaran terbaru.</p>
        </div>
      )}

      {items.length > 0 && (
        <>
          <p class="text-sm text-stone-light mb-6 text-center">
            {totalDocs} {totalDocs === 1 ? 'yacht' : 'yachts'} available
          </p>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" data-animate="stagger">
            {items.map((yacht) => <YachtCard yacht={yacht} />)}
          </div>
        </>
      )}
    </div>
  </section>
</PageLayout>
