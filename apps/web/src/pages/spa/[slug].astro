---
import PageLayout from '@layouts/PageLayout.astro'
import Icon from '@components/common/Icon.astro'
import BlockRenderer from '@components/blocks/BlockRenderer.astro'
import { getSpas, getSpaBySlug, getSiteSettings } from '@lib/payload'
import { isModuleEnabled } from '@lib/features'
import { generateWhatsAppLink, renderWhatsAppTemplate, spaMessage } from '@lib/whatsapp'
import { getServiceWhatsApp } from '@lib/serviceTypes'
import { formatPrice } from '@shared/utils/format-price'
import { siteConfig } from '@config/site'
import { lexicalToPlainText } from '@lib/lexical'
import Breadcrumbs from '@components/common/Breadcrumbs.astro'
import StructuredData from '@components/common/StructuredData.astro'
import { serviceItemSchema } from '@lib/structuredData'
import type { Spa, Media } from '@shared/types/payload-types'

export async function getStaticPaths() {
  if (!(await isModuleEnabled('spa'))) return []
  const { docs } = await getSpas({ limit: 200 })
  return docs.map((r) => ({ params: { slug: r.slug } }))
}

const { slug } = Astro.params
if (!slug) return Astro.redirect('/spa')

const item = await getSpaBySlug(slug)
if (!item) return Astro.redirect('/404')

const asMedia = (v: unknown): Media | null => (v && typeof v === 'object' ? (v as Media) : null)
const dest = typeof item.destination === 'object' ? item.destination : null

// ── Hero bento ─────────────────────────────────────────────
const heroImg = asMedia(item.featuredImage)
const heroUrl = heroImg?.sizes?.hero?.url ?? heroImg?.url ?? ''
const heroAlt = heroImg?.alt ?? item.title
const galleryImages = (item.gallery ?? [])
  .map((g) => asMedia(g.image))
  .filter((m): m is Media => !!m)
const sideImg1 = galleryImages[0]
const sideImg2 = galleryImages[1]
const totalPhotos = 1 + galleryImages.length

// ── Pricing tiers → cheapest for sidebar ───────────────────
const tiers = item.pricingTiers ?? []
const cheapestTier = tiers
  .filter((t) => typeof t.price === 'number' && t.price > 0)
  .sort((a, b) => (a.price ?? 0) - (b.price ?? 0))[0]
const cheapestFormatted = cheapestTier ? formatPrice(cheapestTier.price, cheapestTier.currency ?? 'IDR') : null
const durationLabelMap: Record<string, string> = {
  hourly: 'hour', half_day: 'half day', full_day: 'day', weekly: 'week', monthly: 'month',
}
const durationSuffix = cheapestTier?.duration ? durationLabelMap[cheapestTier.duration] ?? 'day' : 'day'

// ── Text + related data ────────────────────────────────────
const descriptionText = lexicalToPlainText(item.description)
const specs = item.specifications ?? {}
const includes = (item.includes ?? []) as Array<{ item: string }>
const features = ((item as any).features ?? []) as Array<{ name: string; icon?: string }>
const requirements = item.requirements as string | undefined
const subtitle = (item as any).subtitle as string | undefined

const treatmentLabel: Record<typeof item.treatmentType, string> = {
  'Balines Spa': '💆 Balinese Spa',
  'Traditional Massage': '💆 Traditional Massage',
  'Thai massage': '💆 Thai Massage',
  'Honeymoon package': '💑 Honeymoon Package',
  other: '💆 Spa',
}

// Sidebar tags — top features (parity dgn villa highlightTags)
const topTags = features.slice(0, 4).map((f) => f.name)

// Quick specs — CMS override or derive
type QuickSpec = { iconName: string; label: string; subtitle?: string }
const cmsQuickSpecs = ((item as any).quickSpecs ?? []) as QuickSpec[]
const derivedQuickSpecs: QuickSpec[] = [
  { iconName: 'badge',         label: specs.brand ?? '—',                  subtitle: 'Brand' },
  { iconName: 'star',          label: specs.model ?? '—',                  subtitle: 'Model' },
  { iconName: 'schedule',      label: specs.year ?? '—',                    subtitle: 'Year' },
  { iconName: 'verified_user', label: `${features.length || '—'} Features`, subtitle: 'Included' },
]
const quickSpecs = cmsQuickSpecs.length > 0 ? cmsQuickSpecs.slice(0, 4) : derivedQuickSpecs

// Custom super-admin blocks
const additionalBlocks = ((item as any).additionalBlocks ?? []) as any[]

// WhatsApp
let waNumber = siteConfig.contact.whatsapp
try {
  const settings = await getSiteSettings()
  waNumber = settings?.contact?.whatsapp ?? siteConfig.contact.whatsapp
} catch { /* fallback */ }
const svcWa = await getServiceWhatsApp('spa', waNumber).catch(() => ({ number: waNumber, template: undefined }))
waNumber = svcWa.number
const waLink = generateWhatsAppLink(
  waNumber,
  item.whatsappMessage
    ?? (svcWa.template ? renderWhatsAppTemplate(svcWa.template, { serviceName: item.title }) : spaMessage(item.title)),
)

// Recommended — same type
let recommended: Spa[] = []
try {
  const { docs } = await getSpas({
    limit: 10,
    where: { treatmentType: { equals: item.treatmentType } },
    sort: 'sortOrder',
  })
  recommended = docs.filter((d) => d.id !== item.id).slice(0, 3)
} catch { /* no recs */ }

const title = item.seo?.metaTitle ?? `${item.title} — Spa`
const description = item.seo?.metaDescription ?? descriptionText.slice(0, 160)

// ── SEO: breadcrumbs + JSON-LD (D-tech) ──
const detailUrl = `/spa/${slug}`
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Spas', url: '/spa' },
  { name: item.title, url: detailUrl },
]
const itemSchema = serviceItemSchema({
  serviceType: 'spa', name: item.title,
  description: descriptionText ? descriptionText.slice(0, 300) : undefined,
  url: detailUrl, image: heroUrl || undefined,
  price: cheapestTier?.price ?? null, currency: cheapestTier?.currency ?? 'IDR',
  addressLocality: dest?.name ?? undefined,
  site: Astro.site?.href,
})
---

<PageLayout title={title} description={description} ogType="product" ogImage={heroUrl || undefined}>
  <Breadcrumbs items={crumbs} />
  <StructuredData schema={itemSchema} />
  {/* ═══ HERO BENTO GALLERY ═══ */}
  <section class="container-content pt-8 md:pt-12 mb-12 md:mb-16">
    <div class="grid grid-cols-1 md:grid-cols-4 grid-rows-2 gap-3 md:gap-4 h-[50vh] md:h-[70vh] rounded-2xl overflow-hidden shadow-lg">
      <div class="md:col-span-3 row-span-2 relative group">
        {heroUrl ? (
          <img src={heroUrl} alt={heroAlt} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="eager" fetchpriority="high" />
        ) : (
          <div class="w-full h-full bg-sand flex items-center justify-center text-stone-light">No image</div>
        )}
        <div class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors duration-500"></div>
      </div>
      <div class="hidden md:block relative group overflow-hidden">
        {sideImg1 ? <img src={sideImg1.sizes?.card?.url ?? sideImg1.url ?? ''} alt={sideImg1.alt ?? ''} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" /> : <div class="w-full h-full bg-sand"></div>}
        <div class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors duration-500"></div>
      </div>
      <div class="hidden md:block relative group overflow-hidden">
        {sideImg2 ? <img src={sideImg2.sizes?.card?.url ?? sideImg2.url ?? ''} alt={sideImg2.alt ?? ''} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" /> : <div class="w-full h-full bg-sand"></div>}
        <div class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors duration-500"></div>
        {galleryImages.length > 2 && (
          <a href="#options" class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 text-white text-sm font-semibold gap-2 no-underline">
            <Icon name="filter_list" class="w-5 h-5" /> Show all {totalPhotos} photos
          </a>
        )}
      </div>
    </div>
  </section>

  {/* ═══ MAIN 12-COL LAYOUT ═══ */}
  <section class="container-content grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 mb-24">
    <div class="lg:col-span-8">

      {/* ─── Title area + description ─── */}
      <div class="mb-10 pb-10 border-b border-sand-dark/30">
        <div class="flex flex-wrap justify-between items-start gap-4 mb-4">
          <div class="min-w-0">
            <p class="text-xs uppercase tracking-widest text-coral mb-2 font-semibold">{treatmentLabel[item.treatmentType]}</p>
            <h1 class="font-display text-3xl md:text-4xl lg:text-5xl text-ocean mb-2">{item.title}</h1>
            {subtitle && <p class="text-stone-light text-sm md:text-base mb-3 italic">{subtitle}</p>}
            {dest && (
              <div class="flex items-center gap-2 text-stone">
                <Icon name="location_on" class="w-4 h-4 text-coral" />
                <span class="text-sm">{dest.name}, Bali</span>
              </div>
            )}
          </div>
          {cheapestFormatted && (
            <div class="text-right hidden sm:block shrink-0">
              <p class="text-xs uppercase tracking-widest text-stone-light font-semibold mb-1">Starting from</p>
              <p class="font-display text-xl md:text-2xl text-ocean">{cheapestFormatted} <span class="text-sm text-stone-light font-normal">/ {durationSuffix}</span></p>
            </div>
          )}
        </div>
        {descriptionText && <p class="text-stone text-base md:text-lg leading-relaxed mt-6">{descriptionText}</p>}
      </div>

      {/* ─── Quick Specs 4-card ─── */}
      {quickSpecs.length > 0 && (
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-12">
          {quickSpecs.map((spec) => (
            <div class="flex flex-col items-center p-5 md:p-6 bg-white rounded-xl shadow-sm border border-sand-dark/10 text-center">
              <div class="mb-3 text-coral"><Icon name={spec.iconName || 'star'} class="w-8 h-8" /></div>
              <p class="font-semibold text-ocean text-sm md:text-base">{spec.label}</p>
              {spec.subtitle && <p class="text-xs text-stone-light mt-1">{spec.subtitle}</p>}
            </div>
          ))}
        </div>
      )}

      {/* ─── Features (styled = villa Amenities) ─── */}
      {features.length > 0 && (
        <div class="mb-12 pb-12 border-b border-sand-dark/30">
          <h2 class="font-display text-2xl md:text-3xl text-ocean mb-8">Features &amp; Services</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-4 gap-x-8">
            {features.map((f) => (
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-ocean/10 flex items-center justify-center text-ocean shrink-0">
                  <Icon name={f.icon ?? 'star'} class="w-5 h-5" />
                </div>
                <span class="text-stone text-sm md:text-base">{f.name}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* ─── Location (styled = villa Location, brand/model/year sub-cards) ─── */}
      {(specs.brand || specs.model || specs.year || specs.details) && (
        <div class="mb-12 pb-12 border-b border-sand-dark/30">
          <h2 class="font-display text-2xl md:text-3xl text-ocean mb-6">Specifications</h2>
          {specs.details && (
            <div class="w-full min-h-[120px] bg-white rounded-2xl overflow-hidden border border-sand-dark/20 p-6 md:p-8 flex items-center">
              <p class="text-stone text-sm md:text-base leading-relaxed whitespace-pre-line">{specs.details}</p>
            </div>
          )}
          {(specs.brand || specs.model || specs.year) && (
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6 mt-8">
              {specs.brand && (
                <div class="p-5 md:p-6 bg-white rounded-xl border border-sand-dark/10 text-center">
                  <p class="text-xs uppercase tracking-wider text-stone-light font-semibold mb-1">Brand</p>
                  <p class="font-display text-lg text-ocean">{specs.brand}</p>
                </div>
              )}
              {specs.model && (
                <div class="p-5 md:p-6 bg-white rounded-xl border border-sand-dark/10 text-center">
                  <p class="text-xs uppercase tracking-wider text-stone-light font-semibold mb-1">Model</p>
                  <p class="font-display text-lg text-ocean">{specs.model}</p>
                </div>
              )}
              {specs.year && (
                <div class="p-5 md:p-6 bg-white rounded-xl border border-sand-dark/10 text-center">
                  <p class="text-xs uppercase tracking-wider text-stone-light font-semibold mb-1">Year</p>
                  <p class="font-display text-lg text-ocean">{specs.year}</p>
                </div>
              )}
            </div>
          )}
        </div>
      )}

      {/* ─── Policies (styled = villa Policies, from requirements) ─── */}
      {requirements && (
        <div class="mb-12">
          <h2 class="font-display text-2xl md:text-3xl text-ocean mb-6">Requirements &amp; Policies</h2>
          <div class="bg-white rounded-xl border border-sand-dark/10 p-5 md:p-6 text-stone text-sm whitespace-pre-line">
            {requirements}
          </div>
        </div>
      )}

      {/* ─── Options (styled = villa Room Options, per-tier card) ─── */}
      {tiers.length > 0 && (
        <div class="mb-12" id="options">
          <h2 class="font-display text-2xl md:text-3xl text-ocean mb-6">Pricing Options</h2>
          <div class="space-y-4">
            {tiers.map((t) => (
              <div class="bg-white rounded-xl border border-sand-dark/10 p-5 md:p-6 flex flex-wrap items-start gap-4 md:gap-6">
                <div class="flex-1 min-w-0">
                  <h3 class="font-display text-lg text-ocean mb-2 capitalize">{(t.duration ?? '').replace(/_/g, ' ')}</h3>
                  {t.note && <p class="text-sm text-stone">{t.note}</p>}
                </div>
                {typeof t.price === 'number' && t.price > 0 && (
                  <div class="text-right shrink-0">
                    <p class="text-coral font-semibold text-lg">{formatPrice(t.price, t.currency ?? 'IDR')}</p>
                    <p class="text-xs text-stone-light">per {durationLabelMap[t.duration ?? 'full_day'] ?? 'day'}</p>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      )}

      {/* ─── Includes (bonus, styled consistent) ─── */}
      {includes.length > 0 && (
        <div class="mb-12">
          <h2 class="font-display text-2xl md:text-3xl text-ocean mb-6">What's Included</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-3 gap-x-8">
            {includes.map((i) => (
              <div class="flex items-start gap-3">
                <span class="text-leaf mt-1">✓</span>
                <span class="text-stone text-sm md:text-base">{i.item}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>

    {/* ─── SIDEBAR (parity dgn villa sidebar) ─── */}
    <aside class="lg:col-span-4">
      <div class="lg:sticky lg:top-28 bg-white rounded-2xl shadow-lg border border-sand-dark/10 p-6 md:p-8">
        {topTags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-6">
            {topTags.map((tag) => (
              <span class="px-3 py-1 bg-ocean/10 text-ocean rounded-full text-[10px] uppercase tracking-wider font-bold">{tag}</span>
            ))}
          </div>
        )}

        {cheapestFormatted && (
          <div class="mb-6 flex justify-between items-end">
            <div>
              <p class="text-xs uppercase tracking-widest text-stone-light font-semibold mb-1">From</p>
              <p class="font-display text-2xl md:text-3xl text-ocean">
                {cheapestFormatted}
                <span class="text-sm text-stone-light font-normal"> / {durationSuffix}</span>
              </p>
            </div>
          </div>
        )}

        <form class="space-y-4" onsubmit="return false;">
          <div class="grid grid-cols-2 gap-3">
            <label class="block">
              <span class="block text-xs font-semibold text-stone mb-1">Pick-up</span>
              <div class="relative">
                <input type="date" class="w-full bg-sand border border-sand-dark/30 rounded-lg py-2.5 px-3 pl-9 text-sm text-stone focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean transition-colors" />
                <Icon name="calendar_today" class="w-4 h-4 absolute left-2.5 top-1/2 -translate-y-1/2 text-stone-light pointer-events-none" />
              </div>
            </label>
            <label class="block">
              <span class="block text-xs font-semibold text-stone mb-1">Return</span>
              <div class="relative">
                <input type="date" class="w-full bg-sand border border-sand-dark/30 rounded-lg py-2.5 px-3 pl-9 text-sm text-stone focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean transition-colors" />
                <Icon name="calendar_today" class="w-4 h-4 absolute left-2.5 top-1/2 -translate-y-1/2 text-stone-light pointer-events-none" />
              </div>
            </label>
          </div>
          <label class="block">
            <span class="block text-xs font-semibold text-stone mb-1">Quantity</span>
            <div class="relative">
              <select class="w-full bg-sand border border-sand-dark/30 rounded-lg py-2.5 px-3 pl-9 pr-8 text-sm text-stone focus:outline-none focus:border-ocean appearance-none transition-colors cursor-pointer">
                {Array.from({ length: 10 }, (_, i) => i + 1).map((n) => <option>{n} {n === 1 ? 'unit' : 'units'}</option>)}
              </select>
              <Icon name="badge" class="w-4 h-4 absolute left-2.5 top-1/2 -translate-y-1/2 text-stone-light pointer-events-none" />
              <Icon name="expand_more" class="w-4 h-4 absolute right-2.5 top-1/2 -translate-y-1/2 text-stone-light pointer-events-none" />
            </div>
          </label>

          <a href={waLink} target="_blank" rel="noopener noreferrer" class="block w-full bg-coral hover:bg-coral-dark text-white text-center py-3.5 rounded-lg font-semibold text-sm uppercase tracking-wider transition-colors no-underline shadow-md hover:shadow-lg">Reserve Now</a>
        </form>

        {(specs.brand || specs.year) && (
          <div class="mt-6 pt-6 border-t border-sand-dark/30 grid grid-cols-2 gap-3 text-center">
            {specs.brand && (
              <div>
                <p class="text-[10px] uppercase tracking-wider text-stone-light font-semibold">Brand</p>
                <p class="text-sm font-semibold text-ocean mt-1">{specs.brand}</p>
              </div>
            )}
            {specs.year && (
              <div>
                <p class="text-[10px] uppercase tracking-wider text-stone-light font-semibold">Year</p>
                <p class="text-sm font-semibold text-ocean mt-1">{specs.year}</p>
              </div>
            )}
          </div>
        )}

        <div class="mt-6 pt-6 border-t border-sand-dark/30 text-center">
          <p class="text-xs text-stone-light mb-4">You won't be charged yet. Our concierge will confirm details.</p>
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 w-full border border-ocean text-ocean hover:bg-ocean hover:text-white py-3 rounded-lg font-semibold text-sm no-underline transition-colors">
            <Icon name="headset_mic" class="w-4 h-4" /> Contact Concierge
          </a>
        </div>
      </div>
    </aside>
  </section>

  {/* ═══ CUSTOM SECTIONS ═══ */}
  {additionalBlocks.length > 0 && <BlockRenderer blocks={additionalBlocks} />}

  {/* ═══ RECOMMENDED ALTERNATIVES ═══ */}
  {recommended.length > 0 && (
    <section class="container-content mb-24">
      <div class="flex flex-wrap justify-between items-end gap-4 mb-10">
        <h2 class="font-display text-2xl md:text-3xl text-ocean">Curated Alternatives</h2>
        <a href="/spa" class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-ocean hover:text-coral transition-colors no-underline">Explore All Spa's <Icon name="arrow_forward" class="w-4 h-4" /></a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        {recommended.map((rec) => {
          const rImg = asMedia(rec.featuredImage)
          const rUrl = rImg?.sizes?.card?.url ?? rImg?.url ?? ''
          const rTiers = rec.pricingTiers ?? []
          const rPrice = rTiers.filter((t) => typeof t.price === 'number' && t.price > 0).sort((a, b) => (a.price ?? 0) - (b.price ?? 0))[0]
          const rPriceStr = rPrice ? formatPrice(rPrice.price, rPrice.currency ?? 'IDR') : null
          const rDurSuffix = rPrice?.duration ? durationLabelMap[rPrice.duration] ?? 'day' : 'day'
          return (
            <a href={`/spa/${rec.slug}`} class="group block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-transparent hover:border-sand-dark/20 hover:-translate-y-1 no-underline">
              <div class="relative h-56 overflow-hidden">
                {rUrl && <img src={rUrl} alt={rImg?.alt ?? rec.title} loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />}
                {rPriceStr && (
                  <div class="absolute top-3 right-3 bg-white/95 backdrop-blur-sm px-3 py-1 rounded-full">
                    <span class="text-xs font-semibold text-ocean">{rPriceStr}<span class="font-normal text-stone-light">/{rDurSuffix}</span></span>
                  </div>
                )}
              </div>
              <div class="p-5">
                <p class="text-xs uppercase tracking-wider text-coral font-semibold mb-1">{treatmentLabel[rec.treatmentType]}</p>
                <h3 class="font-display text-lg text-ocean mb-1 group-hover:text-coral transition-colors">{rec.title}</h3>
                {rec.specifications?.brand && <p class="text-xs text-stone-light flex items-center gap-1"><Icon name="badge" class="w-3 h-3" /> {rec.specifications.brand} {rec.specifications.model ?? ''}</p>}
              </div>
            </a>
          )
        })}
      </div>
      <div class="mt-8 text-center sm:hidden">
        <a href="/spa" class="inline-flex items-center gap-2 text-sm font-semibold text-ocean bg-ocean/10 px-6 py-3 rounded-lg no-underline">
          Explore All Spas <Icon name="arrow_forward" class="w-4 h-4" />
        </a>
      </div>
    </section>
  )}
</PageLayout>
