---
import PageLayout from '@layouts/PageLayout.astro'
import BlockRenderer from '@components/blocks/BlockRenderer.astro'
import { getPages, getPageBySlug } from '@lib/payload'
import { getResolvedServiceTypes } from '@lib/serviceTypes'

// Catch-all for CMS-driven pages. Runs AFTER static routes like /tours,
// /accommodations, etc., so those service module URLs are never overridden
// by a CMS Page even if a Page with that slug exists.
export async function getStaticPaths() {
  const { docs } = await getPages({ limit: 500 })
  return docs
    .filter((p) => p.slug)
    .map((p) => ({ params: { slug: p.slug } }))
}

const { slug } = Astro.params
if (!slug) return new Response(null, { status: 404 })

const page = await getPageBySlug(slug)
if (!page) return new Response(null, { status: 404 })

// Task 3.3 — kalau ini landing page sebuah service type (slug cocok),
// SEO fallback ke ServiceType.metaTitle/metaDescription (CMS-managed).
const svcTypes = await getResolvedServiceTypes().catch(() => [])
const svcMeta = svcTypes.find((s) => s.slug === slug) ?? null

const title = page.seo?.metaTitle ?? svcMeta?.metaTitle ?? page.title
const description = page.seo?.metaDescription ?? svcMeta?.metaDescription ?? undefined
---

<PageLayout title={title} description={description}>
  <BlockRenderer blocks={page.content} />
</PageLayout>
