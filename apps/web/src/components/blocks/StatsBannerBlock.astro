---
import type { Page } from '@shared/types/payload-types'
import Icon from '@components/common/Icon.astro'
import {
  resolveAlignment, resolveContainer, resolvePadding,
  resolveEntryAnimation,
  resolveTextColor, resolveTextAnimIn,
} from '@lib/blockStyles'

type Block = Extract<NonNullable<Page['content']>[number], { blockType: 'statsBanner' }>
interface Props { block: Block }
const { block } = Astro.props

const b = block as any

const bg = typeof block.backgroundImage === 'object' ? block.backgroundImage : null
const bgUrl = bg?.sizes?.hero?.url ?? bg?.url ?? ''

// Advanced tab (no background group — see CMS notes)
const align = resolveAlignment(b.contentAlignment)
const containerClass = resolveContainer(b.containerWidth)
const paddingClass = resolvePadding(b.sectionPadding)
const entry = resolveEntryAnimation(b.entryAnimation)

const ts = b.ts ?? {}
const eyebrowColor = resolveTextColor(ts.eyebrowColor)
const eyebrowAnim = resolveTextAnimIn(ts.eyebrowAnimIn)
const hColor = resolveTextColor(ts.headingColor)
const hAnim = resolveTextAnimIn(ts.headingAnimIn)
const labelColor = resolveTextColor(ts.labelColor) // for item.value (big number)
const labelAnim = resolveTextAnimIn(ts.labelAnimIn)
const captionColor = resolveTextColor(ts.captionColor) // for item.caption
const captionAnim = resolveTextAnimIn(ts.captionAnimIn)
---

<section class:list={['relative bg-ocean text-white overflow-hidden', paddingClass]} data-animate={entry.dataAnimate}>
  {bgUrl && (
    <div class="absolute inset-0 opacity-10">
      <img src={bgUrl} alt="" class="w-full h-full object-cover" />
    </div>
  )}

  <div class:list={['relative mx-auto', containerClass, align.text, entry.className]}>
    {block.eyebrow && (
      <p class:list={['text-xs uppercase tracking-widest mb-2', eyebrowColor || 'text-white/70', eyebrowAnim]} data-animate="reveal">
        {block.eyebrow}
      </p>
    )}
    <h2 class:list={['font-display text-3xl md:text-4xl mb-12', hColor || 'text-white', hAnim]} data-animate="reveal">
      {block.heading}
    </h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8" data-animate="stagger">
      {block.items.map((item) => (
        <div>
          <div class="inline-flex mb-4 text-white/90">
            <Icon name={item.iconName} class="w-12 h-12" strokeWidth={1.5} />
          </div>
          <p class:list={['font-display text-3xl md:text-4xl font-bold mb-1', labelColor, labelAnim]}>{item.value}</p>
          <p class:list={['text-sm', captionColor || 'text-white/80', captionAnim]}>{item.caption}</p>
        </div>
      ))}
    </div>
  </div>
</section>
