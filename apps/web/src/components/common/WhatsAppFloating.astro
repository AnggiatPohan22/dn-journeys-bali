---
import Icon from '@components/common/Icon.astro'
import { siteConfig } from '@config/site'
import { getSiteSettings } from '@lib/payload'
import { isFeatureEnabled } from '@lib/features'
import { generateWhatsAppLink } from '@lib/whatsapp'

/**
 * WhatsAppFloating — bulat 56px fixed di bottom-right.
 * Klik → popup panel muncul di atas button dengan 1+ chat option.
 * Klik option → open WhatsApp dengan message pre-filled.
 *
 * Popup pattern (Intercom/TawkTo-style) → visitor lebih intentional
 * sebelum initiate chat vs direct-WA button.
 *
 * Data cascade: props → CMS SiteSettings → siteConfig fallback.
 *
 * Contoh pakai:
 *   <WhatsAppFloating />                                    <- 1 default option
 *   <WhatsAppFloating options={[...]} title="Chat with us"/> <- multi-option
 */

interface ChatOption {
  title: string
  subtitle: string
  message?: string
  number?: string
}

interface Props {
  /** Popup header title (default: "Start a Conversation") */
  title?: string
  /** Reply-time text di body atas (default: "The team typically replies in a few minutes.") */
  subtitle?: string
  /** Options list. Kalau kosong, auto-generate 1 default dari CMS greeting. */
  options?: ChatOption[]
  /** Override nomor CMS default */
  number?: string
  /** Override greeting message CMS default */
  message?: string
  /** aria-label untuk toggle button */
  label?: string
}

const {
  title = 'Start a Conversation',
  subtitle = 'The team typically replies in a few minutes.',
  options,
  number,
  message,
  label = 'Chat on WhatsApp',
} = Astro.props

let settings = null
try {
  settings = await getSiteSettings()
} catch { /* fallback */ }

const defaultNumber =
  number ??
  settings?.contact?.whatsapp ??
  settings?.whatsappDefaults?.defaultNumber ??
  siteConfig.contact.whatsapp

const defaultMessage =
  message ??
  settings?.whatsappDefaults?.greetingMessage ??
  'Halo DnJourneysBali! 👋\n\nSaya mau tanya-tanya dulu tentang layanan yang tersedia.'

const siteName = settings?.siteName ?? siteConfig.name

// Kalau options tidak dikasih, generate 1 default option dari CMS
const chatOptions: ChatOption[] = options ?? [
  {
    title: `${siteName} — General`,
    subtitle: 'Have a question? Chat with us',
    message: defaultMessage,
    number: defaultNumber,
  },
]

const hasNumber = defaultNumber && defaultNumber.replace(/\D/g, '').length > 0
const featureEnabled = await isFeatureEnabled('whatsappFloat')
const shouldRender = hasNumber && featureEnabled

// Pre-compute wa links untuk tiap option
const optionLinks = chatOptions.map((opt) => ({
  ...opt,
  href: generateWhatsAppLink(opt.number ?? defaultNumber, opt.message ?? defaultMessage),
}))
---

{shouldRender && (
  <div
    class="wa-float-container fixed bottom-6 right-6 z-50"
    data-open="false"
  >
    <!-- Popup panel — positioned above the toggle button.
         opacity/pointer-events classes toggled via JS. Instant show/hide
         (no CSS transition) — CSS transition on opacity gets stuck at
         initial state di Astro-scoped setup ini (verified via debug).
         Trade-off UX minor: popup snap in/out tanpa fade. -->
    <div
      class="wa-popup absolute bottom-full right-0 mb-4 w-80 rounded-2xl overflow-hidden shadow-2xl origin-bottom-right opacity-0 pointer-events-none"
      style="max-width: calc(100vw - 3rem);"
      role="dialog"
      aria-labelledby="wa-popup-title"
    >
      <!-- Header -->
      <div class="bg-[#25D366] text-white p-5 flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center shrink-0">
          <Icon name="whatsapp" class="w-5 h-5" />
        </div>
        <h3 id="wa-popup-title" class="font-display text-lg font-bold">{title}</h3>
      </div>

      <!-- Body -->
      <div class="bg-white p-4 space-y-3">
        <p class="text-xs text-stone-light px-1">{subtitle}</p>

        {optionLinks.map((opt) => (
          <a
            href={opt.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-3 bg-sand hover:bg-sand-dark/40 rounded-xl transition-colors border-l-4 border-[#25D366] no-underline group"
          >
            <div class="w-11 h-11 rounded-full bg-[#25D366] text-white flex items-center justify-center shrink-0">
              <Icon name="whatsapp" class="w-6 h-6" />
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-ocean text-sm">{opt.title}</p>
              <p class="text-xs text-stone-light truncate">{opt.subtitle}</p>
            </div>
            <Icon name="whatsapp" class="w-5 h-5 text-[#25D366] shrink-0 opacity-70 group-hover:opacity-100 transition-opacity" />
          </a>
        ))}
      </div>
    </div>

    <!-- Toggle button — bulat 56px WhatsApp green -->
    <button
      type="button"
      class="wa-toggle wa-float-animate w-14 h-14 rounded-full bg-[#25D366] hover:bg-[#1DA851] text-white flex items-center justify-center shadow-lg hover:shadow-xl active:scale-95 transition-all duration-200"
      aria-label={label}
      aria-expanded="false"
      aria-haspopup="dialog"
    >
      <Icon name="whatsapp" class="w-7 h-7" />
    </button>
  </div>
)}

<style>
  /* Entrance animation for toggle button on page load */
  @keyframes wa-float-in {
    from { opacity: 0; transform: scale(0.5) translateY(20px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }
  .wa-float-animate {
    animation: wa-float-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float-animate { animation: none; }
  }
</style>

<script>
  const initWaFloat = () => {
    const container = document.querySelector<HTMLElement>('.wa-float-container')
    if (!container) return
    const toggle = container.querySelector<HTMLButtonElement>('.wa-toggle')
    const popup = container.querySelector<HTMLElement>('.wa-popup')
    if (!toggle || !popup) return

    // Classes toggled on popup for open/close.
    // Opacity + pointer-events only (see popup markup comment for rationale).
    const closedClasses = ['opacity-0', 'pointer-events-none']
    const openClasses = ['opacity-100', 'pointer-events-auto']

    const setOpen = (open: boolean) => {
      container.dataset.open = String(open)
      toggle.setAttribute('aria-expanded', String(open))
      if (open) {
        popup.classList.remove(...closedClasses)
        popup.classList.add(...openClasses)
      } else {
        popup.classList.remove(...openClasses)
        popup.classList.add(...closedClasses)
      }
    }

    toggle.addEventListener('click', (e) => {
      e.stopPropagation()
      const isOpen = container.dataset.open === 'true'
      setOpen(!isOpen)
    })

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (container.dataset.open !== 'true') return
      const target = e.target as Node
      if (!container.contains(target)) setOpen(false)
    })

    // Close on ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && container.dataset.open === 'true') {
        setOpen(false)
        toggle.focus()
      }
    })

    // Close popup after user clicks a chat option (before WA opens in new tab)
    container.querySelectorAll('.wa-popup a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false))
    })
  }

  document.addEventListener('astro:page-load', initWaFloat)
  initWaFloat()
</script>
