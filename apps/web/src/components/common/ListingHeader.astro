---
/**
 * Header standar untuk halaman listing service (tours, accommodations, dst).
 * Markup diekstrak dari 6 listing `index.astro` yang sebelumnya identik.
 * Sumber teks: `resolveListingHeader()` (CMS ServiceTypes + fallback).
 */
interface Props {
  eyebrow: string
  heading: string
  intro: string
}
const { eyebrow, heading, intro } = Astro.props
---

<header class="mb-12 text-center max-w-3xl mx-auto">
  <p class="text-sm uppercase tracking-wider text-leaf mb-3">{eyebrow}</p>
  <h1 class="font-display text-4xl md:text-5xl text-ocean mb-4" data-animate="reveal">
    {heading}
  </h1>
  {intro && (
    <p class="text-stone" data-animate="reveal">{intro}</p>
  )}
</header>
