---
import { siteConfig } from '@config/site'
import { getSiteSettings, getMenuBySlug, getHeaderSettings } from '@lib/payload'
import { defaultTemplateId } from '@shared/template-registry'
import type { Media, Menu, SiteSetting } from '@shared/types/payload-types'
import HeaderTemplate1 from './templates/HeaderTemplate1.astro'
import HeaderTemplate2 from './templates/HeaderTemplate2.astro'
import HeaderTemplate3 from './templates/HeaderTemplate3.astro'

interface Props { transparent?: boolean }
const { transparent: transparentProp } = Astro.props

// ── Fetch ───────────────────────────────────────────────
let settings: SiteSetting | null = null
let headerCfg: any = null
try { settings = await getSiteSettings() } catch { /* fallback */ }
try { headerCfg = await getHeaderSettings() } catch { /* fallback */ }

// ── Menu resolution (primaryMenu populated, else fallback slug) ──
let menu: Menu | null = null
const primaryMenuData = headerCfg?.primaryMenu
if (primaryMenuData && typeof primaryMenuData === 'object' && Array.isArray(primaryMenuData.items)) {
  menu = primaryMenuData as Menu
} else {
  try { menu = await getMenuBySlug('main-navigation') } catch { /* fallback nav */ }
}

const siteName = settings?.siteName ?? siteConfig.name
const logo = (typeof settings?.logo === 'object' ? settings.logo : null) as Media | null
const logoUrl = logo?.url ?? ''
const logoAlt = logo?.alt ?? siteName

// ── CTA ─────────────────────────────────────────────────
const showCta = headerCfg?.showCtaButton !== false
const ctaText = headerCfg?.ctaText || 'WhatsApp Booking'
const ctaType = headerCfg?.ctaType || 'whatsapp'
const waRaw = settings?.contact?.whatsapp ?? siteConfig.contact.whatsapp
const waNumber = String(waRaw).replace(/\D/g, '')
const ctaHref = ctaType === 'custom' && headerCfg?.ctaCustomLink ? headerCfg.ctaCustomLink : `https://wa.me/${waNumber}`
const ctaIsExternal = ctaHref.startsWith('http')

const transparent = transparentProp !== undefined ? transparentProp : (headerCfg?.transparentOnTop ?? false)

// ── Nav items ───────────────────────────────────────────
type NavItem = { label: string; url: string; target?: '_self' | '_blank' | null; children?: NavItem[]; asSpan?: boolean }
const resolveChildUrl = (c: any): { url: string; asSpan: boolean } => {
  if (c.type === 'none') return { url: '#', asSpan: true }
  if (c.type === 'page' && typeof c.page === 'object' && c.page) return { url: `/${c.page.slug ?? ''}`, asSpan: false }
  return { url: c.url ?? '#', asSpan: false }
}
const fallbackNav: NavItem[] = [
  { label: 'Home', url: '/' },
  { label: 'Tours', url: '/tour' },
  { label: 'Contact', url: '/contact' },
]
const navItems: NavItem[] = (menu?.items ?? []).map((item: any) => {
  const asSpan = item.type === 'none'
  const url = asSpan ? '#'
    : item.type === 'page' && typeof item.page === 'object' && item.page ? `/${item.page.slug ?? ''}`
    : (item.url ?? '#')
  return {
    label: item.label, url, target: item.target, asSpan,
    children: (item.children ?? []).map((c: any) => {
      const { url, asSpan } = resolveChildUrl(c)
      return { label: c.label, url, target: c.target, asSpan }
    }),
  }
})
const items = navItems.length > 0 ? navItems : fallbackNav
const currentPath = new URL(Astro.request.url).pathname

// ── Social + top bar (untuk template yang pakai slot ini) ──
const socialRaw = settings?.socialMedia ?? {}
const socialUrl = (platform: string, raw?: string) => {
  if (!raw) return ''
  if (/^https?:\/\//.test(raw)) return raw
  const bases: Record<string, string> = {
    instagram: 'https://instagram.com/', facebook: 'https://facebook.com/',
    tiktok: 'https://tiktok.com/@', youtube: 'https://youtube.com/@', tripadvisor: 'https://tripadvisor.com/',
  }
  return (bases[platform] ?? '') + String(raw).replace(/^@/, '')
}
const social = {
  instagram: socialUrl('instagram', (socialRaw as any).instagram),
  facebook: socialUrl('facebook', (socialRaw as any).facebook),
  tiktok: socialUrl('tiktok', (socialRaw as any).tiktok),
  youtube: socialUrl('youtube', (socialRaw as any).youtube),
}
const topBar = {
  showAddress: headerCfg?.showTopBarAddress !== false,
  showPhone: headerCfg?.showTopBarPhone !== false,
  address: settings?.contact?.address ?? '',
  phone: settings?.contact?.phone ?? '',
  text: headerCfg?.topBarText ?? '',
}

const ctx = {
  siteName, logoUrl, logoAlt, items, currentPath, transparent,
  cta: { show: showCta, text: ctaText, href: ctaHref, external: ctaIsExternal },
  showSearch: headerCfg?.showSearch !== false,
  showSocial: headerCfg?.showSocialLinks !== false,
  social, topBar,
}

const TEMPLATES: Record<string, any> = {
  'header-1': HeaderTemplate1,
  'header-2': HeaderTemplate2,
  'header-3': HeaderTemplate3,
}
const templateId = headerCfg?.template || defaultTemplateId('header')
const Template = TEMPLATES[templateId] ?? HeaderTemplate1
---
<Template {...ctx} />
